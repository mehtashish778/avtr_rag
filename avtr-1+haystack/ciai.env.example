# AVTR-1 environment template for the MBZUAI CIAI cluster.
#
# Copy this file to `.env` on CIAI, replace the TURN placeholders, and protect
# the resulting file with `chmod 600 .env`. Never put real secrets in this
# example file or commit the generated `.env`.


# --- Network binding ---------------------------------------------------------

# Required for the laptop tunnel:
#   ssh -N -L 7860:<GPU_NODE>:7860 ciai
# Binding only to 127.0.0.1 on the compute node makes that tunnel fail.
STREAMER_HOST="0.0.0.0"

# The defaults are shown for clarity. Change them only if these ports conflict.
STREAMER_PORT="7860"
RENDERER_PORT="8000"


# --- Persistent CIAI storage -------------------------------------------------

# Shared model artifacts and A100 TensorRT engines.
AVTR1_LOCAL_STORAGE="/l/users/ashish.mehta/avtr_rag-runtime/shared/avtr1-storage"

# Shared Hugging Face authentication and model cache.
HF_HOME="/l/users/ashish.mehta/avtr_rag-runtime/shared/huggingface-cache"

# Hugging Face token with read access to the gated avaturn-live/avtr-1 repo.
# Replace this placeholder only in the untracked `.env` on CIAI. You may omit
# this variable after `hf auth login` has saved a valid token under HF_HOME.
HF_TOKEN="<HUGGINGFACE_TOKEN>"


# --- WebRTC TURN -------------------------------------------------------------

# Create one Cloudflare Realtime TURN key and copy both values from that same
# key. Do not use the Cloudflare Account ID, API-token ID, or an unrelated API
# token. Keep the quotes and replace only the placeholder text.
CLOUDFLARE_TURN_KEY_ID="<TURN_KEY_ID>"
CLOUDFLARE_TURN_KEY_TOKEN="<TURN_API_TOKEN>"


# --- Optional conversation-engine credentials -------------------------------

# The verified local-stream workflow enters the OpenAI API key per session in
# the browser UI, so it is not required here. If the application mode changes
# to server-side configuration, use the upstream variable below and keep it
# only in the untracked `.env` file.
# OPENAI__API_KEY="<OPENAI_API_KEY>"

# Optional Cartesia alternative; leave commented when using OpenAI Realtime.
# CARTESIA_API_KEY="<CARTESIA_API_KEY>"
# CARTESIA_AGENT_ID="<CARTESIA_AGENT_ID>"


# --- Optional ICE overrides --------------------------------------------------

# Cloudflare TURN is used automatically when its key variables above are set.
# These manual values take precedence and should normally remain commented.
# TURN_URL="turn:turn.example.com:3478"
# TURN_USERNAME="<TURN_USERNAME>"
# TURN_CREDENTIAL="<TURN_CREDENTIAL>"

# Defaults to Google's public STUN service when unset.
# STUN_URL="stun:stun.l.google.com:19302"

# --- Hayhooks + native Haystack retrieval -----------------------------------
HAYHOOKS_HOST="127.0.0.1"
HAYHOOKS_PORT="1416"
HAYHOOKS_PIPELINES_DIR="./pipelines"
HAYHOOKS_SHOW_TRACEBACKS="false"
HAYHOOKS_STARTUP_DEPLOY_STRATEGY="sequential"
HAYSTACK_TELEMETRY_ENABLED="false"

HAYSTACK__QDRANT_URL="http://127.0.0.1:6333"
HAYSTACK__QDRANT_COLLECTION="avtr_breast_cancer_haystack"
HAYSTACK__QDRANT_SIMILARITY="cosine"
HAYSTACK__EMBEDDING_DIM="384"
HAYSTACK__EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
HAYSTACK__EMBEDDING_REVISION="1110a243fdf4706b3f48f1d95db1a4f5529b4d41"
HAYSTACK__RANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
HAYSTACK__RANKER_REVISION="233902d25c440f23af6f7d6e94d2946bac0bee0a"

# Pre-pull the Qdrant image once and use a persistent writable storage path.
QDRANT_SIF="/l/users/ashish.mehta/containers/qdrant.sif"
QDRANT_STORAGE="/l/users/ashish.mehta/avtr_rag-runtime/qdrant"

RAG__ENABLED="true"
RAG__BACKEND="haystack"
RAG__BASE_URL="http://127.0.0.1:1416"
RAG__API_KEY=""
RAG__INITIAL_TOP_K="10"
RAG__TOP_K="3"
RAG__TIMEOUT_SECONDS="5"
RAG__MAX_CONTEXT_TOKENS="1200"
RAG__MAX_CONTEXT_CHARS="12000"

# Full per-turn JSONL evidence. These files contain voice transcripts and must
# remain private on Lustre storage.
AUDIT__ENABLED="true"
AUDIT__DIRECTORY="/l/users/ashish.mehta/avtr_rag-runtime/logs/haystack/rag-audit"
AUDIT__FULL_CONTENT="false"
AUDIT__MAX_VALUE_CHARS="200000"
